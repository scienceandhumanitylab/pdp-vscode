{
  "name": "pdp-vscode",
  "displayName": "pdp",
  "description": "Principled Data Processing in VScode",
  "version": "0.0.7",
  "publisher": "scienceandhumanitylab",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/scienceandhumanitylab/pdp-vscode.git"
  },
  "engines": {
    "vscode": "^1.140.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "workspaceContains:pdp.yml"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "pdp.init",
        "title": "pdp: Init Project",
        "icon": "$(add)"
      },
      {
        "command": "pdp.create",
        "title": "pdp: Create Task",
        "icon": "$(add)"
      },
      {
        "command": "pdp.scaffold",
        "title": "pdp: Scaffold"
      },
      {
        "command": "pdp.validate",
        "title": "pdp: Validate"
      },
      {
        "command": "pdp.refresh",
        "title": "pdp: Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "pdp.runAll",
        "title": "pdp: Run All (Stale)",
        "icon": "$(play)"
      },
      {
        "command": "pdp.runPick",
        "title": "pdp: Run…"
      },
      {
        "command": "pdp.runTask",
        "title": "pdp: Run Task",
        "icon": "$(play)"
      },
      {
        "command": "pdp.runOnly",
        "title": "pdp: Run Only This Task"
      },
      {
        "command": "pdp.runTo",
        "title": "pdp: Run To Here"
      },
      {
        "command": "pdp.runTaskConfirm",
        "title": "pdp: Run Task (Confirm)"
      },
      {
        "command": "pdp.runFrom",
        "title": "pdp: Run From Here"
      },
      {
        "command": "pdp.runForce",
        "title": "pdp: Force Run Task"
      },
      {
        "command": "pdp.runSlurm",
        "title": "pdp: Run Task on Slurm"
      },
      {
        "command": "pdp.freshenTask",
        "title": "pdp: Freshen Task (and Downstream)"
      },
      {
        "command": "pdp.freshenOnly",
        "title": "pdp: Freshen Only This Task"
      },
      {
        "command": "pdp.cleanTask",
        "title": "pdp: Clean Task",
        "icon": "$(trash)"
      },
      {
        "command": "pdp.cleanTaskConfirm",
        "title": "pdp: Clean Task (Confirm)"
      },
      {
        "command": "pdp.deleteTask",
        "title": "pdp: Delete Task…"
      },
      {
        "command": "pdp.cleanAll",
        "title": "pdp: Clean All",
        "icon": "$(trash)"
      },
      {
        "command": "pdp.openTask",
        "title": "pdp: Open task.yml"
      },
      {
        "command": "pdp.createTaskYml",
        "title": "pdp: Create Task task.yml"
      },
      {
        "command": "pdp.revealTask",
        "title": "pdp: Reveal Task Folder"
      },
      {
        "command": "pdp.openTaskSrc",
        "title": "pdp: Open Task Source File"
      },
      {
        "command": "pdp.createTaskSrc",
        "title": "pdp: Create Task Source File"
      },
      {
        "command": "pdp.openTaskMakefile",
        "title": "pdp: Open Task Makefile"
      },
      {
        "command": "pdp.createTaskMakefile",
        "title": "pdp: Create Task Makefile"
      },
      {
        "command": "pdp.runAllConfirm",
        "title": "pdp: Run All (Confirm)"
      },
      {
        "command": "pdp.cleanAllConfirm",
        "title": "pdp: Clean All (Confirm)"
      },
      {
        "command": "pdp.resetGraphLayout",
        "title": "pdp: Reset Graph Layout",
        "icon": "$(discard)"
      },
      {
        "command": "pdp.saveGraphLayout",
        "title": "pdp: Save Graph Layout as Default",
        "icon": "$(save)"
      },
      {
        "command": "pdp.graphZoomIn",
        "title": "pdp: Graph Zoom In",
        "icon": "$(zoom-in)"
      },
      {
        "command": "pdp.graphZoomOut",
        "title": "pdp: Graph Zoom Out",
        "icon": "$(zoom-out)"
      },
      {
        "command": "pdp.graphChooseLayout",
        "title": "pdp: Choose Graph Layout…",
        "icon": "$(layout)"
      },
      {
        "command": "pdp.dagsterLocal",
        "title": "pdp: Start Dagster (Local)",
        "icon": "$(rocket)"
      },
      {
        "command": "pdp.dagsterSlurm",
        "title": "pdp: Start Dagster (Slurm)"
      },
      {
        "command": "pdp.remoteStart",
        "title": "pdp: Remote Start",
        "icon": "$(globe)"
      },
      {
        "command": "pdp.remoteRunAll",
        "title": "pdp: Remote Run All"
      },
      {
        "command": "pdp.remoteRunTask",
        "title": "pdp: Remote Run Task"
      },
      {
        "command": "pdp.remotePush",
        "title": "pdp: Remote Push"
      },
      {
        "command": "pdp.remotePull",
        "title": "pdp: Remote Pull"
      },
      {
        "command": "pdp.remoteStop",
        "title": "pdp: Remote Stop"
      },
      {
        "command": "pdp.remoteRefresh",
        "title": "pdp: Remote Status",
        "icon": "$(refresh)"
      },
      {
        "command": "pdp.openDagsterUi",
        "title": "pdp: Open Dagster UI",
        "icon": "$(browser)"
      },
      {
        "command": "pdp.showShortcuts",
        "title": "pdp: Keyboard Shortcuts"
      },
      {
        "command": "pdp.rerunLast",
        "title": "pdp: Re-run Last Run"
      },
      {
        "command": "pdp.stopProcess",
        "title": "pdp: Stop Process",
        "icon": "$(debug-stop)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "pdp",
          "title": "pdp",
          "icon": "media/pdp.svg"
        }
      ]
    },
    "views": {
      "pdp": [
        {
          "id": "pdp.tasks",
          "name": "Tasks",
          "initialSize": 1
        },
        {
          "type": "webview",
          "id": "pdp.graph",
          "name": "Graph",
          "initialSize": 3
        },
        {
          "id": "pdp.remote",
          "name": "Remote & Processes",
          "visibility": "collapsed"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "pdp.tasks",
        "when": "!pdp.hasProject",
        "contents": "No pdp project in this workspace.\n[Init project](command:pdp.init)\nTo learn more about pdp, [read the docs](https://github.com/scienceandhumanitylab/pdp)."
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "pdp.runTaskConfirm",
          "when": "false"
        },
        {
          "command": "pdp.cleanTaskConfirm",
          "when": "false"
        },
        {
          "command": "pdp.runAllConfirm",
          "when": "false"
        },
        {
          "command": "pdp.cleanAllConfirm",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "pdp.runAll",
          "when": "view == pdp.tasks",
          "group": "navigation@1"
        },
        {
          "command": "pdp.create",
          "when": "view == pdp.tasks",
          "group": "navigation@2"
        },
        {
          "command": "pdp.refresh",
          "when": "view == pdp.tasks",
          "group": "navigation@3"
        },
        {
          "command": "pdp.runPick",
          "when": "view == pdp.tasks",
          "group": "1_actions@1"
        },
        {
          "command": "pdp.scaffold",
          "when": "view == pdp.tasks",
          "group": "1_actions@2"
        },
        {
          "command": "pdp.validate",
          "when": "view == pdp.tasks",
          "group": "1_actions@3"
        },
        {
          "command": "pdp.init",
          "when": "view == pdp.tasks",
          "group": "2_project@1"
        },
        {
          "command": "pdp.cleanAll",
          "when": "view == pdp.tasks",
          "group": "3_clean@1"
        },
        {
          "command": "pdp.dagsterLocal",
          "when": "view == pdp.remote",
          "group": "navigation@1"
        },
        {
          "command": "pdp.remoteStart",
          "when": "view == pdp.remote",
          "group": "navigation@2"
        },
        {
          "command": "pdp.remoteRefresh",
          "when": "view == pdp.remote",
          "group": "navigation@3"
        },
        {
          "command": "pdp.dagsterSlurm",
          "when": "view == pdp.remote",
          "group": "1_actions@1"
        },
        {
          "command": "pdp.remoteRunAll",
          "when": "view == pdp.remote",
          "group": "1_actions@2"
        },
        {
          "command": "pdp.remotePush",
          "when": "view == pdp.remote",
          "group": "2_remote@1"
        },
        {
          "command": "pdp.remotePull",
          "when": "view == pdp.remote",
          "group": "2_remote@2"
        },
        {
          "command": "pdp.remoteStop",
          "when": "view == pdp.remote",
          "group": "3_stop@1"
        }
      ],
      "view/item/context": [
        {
          "command": "pdp.runTask",
          "when": "view == pdp.tasks && viewItem == task",
          "group": "inline@1"
        },
        {
          "command": "pdp.cleanTask",
          "when": "view == pdp.tasks && viewItem == task",
          "group": "inline@2"
        },
        {
          "command": "pdp.runOnly",
          "when": "view == pdp.tasks && viewItem == task",
          "group": "1_run@1"
        },
        {
          "command": "pdp.runTo",
          "when": "view == pdp.tasks && viewItem == task",
          "group": "1_run@2"
        },
        {
          "command": "pdp.runFrom",
          "when": "view == pdp.tasks && viewItem == task",
          "group": "1_run@3"
        },
        {
          "command": "pdp.runForce",
          "when": "view == pdp.tasks && viewItem == task",
          "group": "1_run@4"
        },
        {
          "command": "pdp.runSlurm",
          "when": "view == pdp.tasks && viewItem == task",
          "group": "1_run@5"
        },
        {
          "command": "pdp.remoteRunTask",
          "when": "view == pdp.tasks && viewItem == task",
          "group": "2_remote@1"
        },
        {
          "command": "pdp.openTask",
          "when": "view == pdp.tasks && viewItem == task",
          "group": "3_open@1"
        },
        {
          "command": "pdp.revealTask",
          "when": "view == pdp.tasks && viewItem == task",
          "group": "3_open@2"
        },
        {
          "command": "pdp.openTaskSrc",
          "when": "view == pdp.tasks && viewItem == task",
          "group": "3_open@3"
        },
        {
          "command": "pdp.cleanTask",
          "when": "view == pdp.tasks && viewItem == task",
          "group": "4_clean@1"
        },
        {
          "command": "pdp.deleteTask",
          "when": "view == pdp.tasks && viewItem == task",
          "group": "5_delete@1"
        },
        {
          "command": "pdp.freshenTask",
          "when": "view == pdp.tasks && viewItem == task",
          "group": "6_freshen@1"
        },
        {
          "command": "pdp.freshenOnly",
          "when": "view == pdp.tasks && viewItem == task",
          "group": "6_freshen@2"
        },
        {
          "command": "pdp.openDagsterUi",
          "when": "view == pdp.remote && viewItem == process",
          "group": "inline@1"
        },
        {
          "command": "pdp.stopProcess",
          "when": "view == pdp.remote && viewItem == process",
          "group": "inline@2"
        }
      ]
    },
    "keybindings": [
      {
        "command": "pdp.tasks.focus",
        "key": "alt+p p",
        "when": "!terminalFocus"
      },
      {
        "command": "pdp.tasks.focus",
        "key": "alt+p t",
        "when": "!terminalFocus"
      },
      {
        "command": "pdp.graph.focus",
        "key": "alt+p g",
        "when": "!terminalFocus"
      },
      {
        "command": "pdp.remote.focus",
        "key": "alt+p r",
        "when": "!terminalFocus"
      },
      {
        "command": "pdp.runAll",
        "key": "alt+p space",
        "when": "pdp.hasProject && !terminalFocus"
      },
      {
        "command": "pdp.rerunLast",
        "key": "alt+p .",
        "when": "pdp.hasProject && !terminalFocus"
      },
      {
        "command": "pdp.graphZoomIn",
        "key": "i",
        "when": "pdp.graphFocused && !terminalFocus"
      },
      {
        "command": "pdp.graphZoomOut",
        "key": "o",
        "when": "pdp.graphFocused && !terminalFocus"
      },
      {
        "command": "pdp.graphChooseLayout",
        "key": "l",
        "when": "pdp.graphFocused && !terminalFocus"
      },
      {
        "command": "pdp.saveGraphLayout",
        "key": "s",
        "when": "pdp.graphFocused && !terminalFocus"
      },
      {
        "command": "pdp.resetGraphLayout",
        "key": "r",
        "when": "pdp.graphFocused && !terminalFocus"
      },
      {
        "command": "pdp.runTaskConfirm",
        "key": "r",
        "when": "focusedView == pdp.tasks && !terminalFocus",
        "args": {
          "selected": true
        }
      },
      {
        "command": "pdp.cleanTaskConfirm",
        "key": "c",
        "when": "focusedView == pdp.tasks && !terminalFocus",
        "args": {
          "selected": true
        }
      },
      {
        "command": "pdp.openTask",
        "key": "t",
        "when": "focusedView == pdp.tasks && !terminalFocus",
        "args": {
          "selected": true
        }
      },
      {
        "command": "pdp.createTaskYml",
        "key": "shift+t",
        "when": "focusedView == pdp.tasks && !terminalFocus",
        "args": {
          "selected": true
        }
      },
      {
        "command": "pdp.freshenTask",
        "key": "f",
        "when": "focusedView == pdp.tasks && !terminalFocus",
        "args": {
          "selected": true
        }
      },
      {
        "command": "pdp.deleteTask",
        "key": "d",
        "when": "focusedView == pdp.tasks && !terminalFocus",
        "args": {
          "selected": true
        }
      },
      {
        "command": "pdp.openTaskSrc",
        "key": "s",
        "when": "focusedView == pdp.tasks && !terminalFocus",
        "args": {
          "selected": true
        }
      },
      {
        "command": "pdp.createTaskSrc",
        "key": "shift+s",
        "when": "focusedView == pdp.tasks && !terminalFocus",
        "args": {
          "selected": true
        }
      },
      {
        "command": "pdp.openTaskMakefile",
        "key": "m",
        "when": "focusedView == pdp.tasks && !terminalFocus",
        "args": {
          "selected": true
        }
      },
      {
        "command": "pdp.createTaskMakefile",
        "key": "shift+m",
        "when": "focusedView == pdp.tasks && !terminalFocus",
        "args": {
          "selected": true
        }
      },
      {
        "command": "pdp.runAllConfirm",
        "key": "shift+r",
        "when": "focusedView == pdp.tasks && !terminalFocus"
      },
      {
        "command": "pdp.cleanAllConfirm",
        "key": "shift+c",
        "when": "focusedView == pdp.tasks && !terminalFocus"
      },
      {
        "command": "pdp.showShortcuts",
        "key": "shift+/",
        "when": "pdp.graphFocused && !terminalFocus",
        "args": "graph"
      },
      {
        "command": "pdp.showShortcuts",
        "key": "shift+/",
        "when": "focusedView == pdp.tasks && !terminalFocus",
        "args": "tasks"
      }
    ],
    "configuration": {
      "title": "pdp",
      "properties": {
        "pdp.path": {
          "type": "string",
          "default": "pdp",
          "markdownDescription": "Path to the `pdp` binary. Defaults to `pdp` on your PATH. Needs pdp ≥ 0.2.5 (`pdp-helper` on PyPI)."
        },
        "pdp.dagsterPort": {
          "type": "number",
          "default": 3000,
          "description": "Port for the local Dagster UI started by pdp: Start Dagster."
        },
        "pdp.graphFontSize": {
          "type": "number",
          "default": 14,
          "description": "Font size (px) of the task graph node labels."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm run compile",
    "compile": "node scripts/copy-cytoscape.mjs && tsc -p ./",
    "watch": "node scripts/copy-cytoscape.mjs && tsc -watch -p ./",
    "pretest": "pnpm run compile && pnpm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.140.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "@vscode/vsce": "^4.1.0",
    "cytoscape": "^3.35.0",
    "eslint": "^10.5.0",
    "prettier": "3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
